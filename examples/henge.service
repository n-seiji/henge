# systemd user unit. Copy to ~/.config/systemd/user/henge.service, then:
#   systemctl --user enable --now henge
#   loginctl enable-linger "$USER"   # keep it running after logout
# After installing a new binary: systemctl --user reload henge
[Unit]
Description=henge
After=network-online.target

[Service]
# .env and data/ are read from the working directory.
WorkingDirectory=%h/henge
ExecStart=%h/.local/bin/henge
ExecReload=/bin/kill -HUP $MAINPID
Environment=TZ=Asia/Tokyo
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
