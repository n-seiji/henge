<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent. Replace YOU with your user name, copy to
  ~/Library/LaunchAgents/local.ebi-x.plist, then:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.ebi-x.plist
  After installing a new binary:
    launchctl kill HUP gui/$(id -u)/local.ebi-x
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.ebi-x</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/ebi-x</string>
  </array>
  <!-- .env and data/ are read from the working directory. -->
  <key>WorkingDirectory</key>
  <string>/Users/YOU/ebi-x</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>Asia/Tokyo</string>
    <!-- launchd starts with a minimal PATH; codex and git must be on it. -->
    <key>PATH</key>
    <string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOU/ebi-x/ebi-x.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/ebi-x/ebi-x.log</string>
</dict>
</plist>
