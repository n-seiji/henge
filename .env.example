# Secrets only. Every other setting is in henge.yaml.
#
# Secrets may be references instead: op://vault/item/field (1Password) or
# keychain:<service> (macOS Keychain). See docs/setup.md.

# Slack bot token (required).
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token for Socket Mode (required).
SLACK_APP_TOKEN=xapp-your-app-token

# Optional GitHub token for watching pull requests the agent created. Read
# access to pull requests, checks, and commit statuses is enough. Leave empty
# to use the credential git already pushes the writable roots' https GitHub
# origins with, or the GitHub App below.
HENGE_GITHUB_TOKEN=

# Optional GitHub App private key: a PEM file path or keychain:<service>.
# Set github.app_id in henge.yaml with it. `henge init` can create the App.
HENGE_GITHUB_APP_PRIVATE_KEY=
